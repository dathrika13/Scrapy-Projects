<script>
  if ($(window).width() > 1024) {  
    $( document ).ready(function() {
      $(".site-menu-header li details").keydown(function(e) {   
        if (e.keyCode == '13') {
          if ($(this).attr('aria-expanded') != "true") {
            setTimeout(() => {
              $(this).attr("aria-expanded", 'true');
              $(this).attr('open','open');
            }, 100);
            console.log("expanded again");
            $("sticky-header").addClass('active');
            $("sticky-header").removeClass("transition-header");
            $(".logo-white-bg").addClass("tw-hidden"); //done
            $(".logo-black-bg").removeClass("tw-hidden"); //done

            if ($(window).scrollTop() > 50) {
              $("sticky-header").addClass("transition-header-black");
            } 
          } else if ($(this).attr('aria-expanded') == "true") {
            setTimeout(() => {
              $(this).removeAttr('open');
              $(this).attr("aria-expanded", 'false');
            }, 100);
            $("sticky-header").removeClass('active');
            $(this).removeAttr('open','');
            if ($(window).scrollTop() > 50) {
              $("sticky-header").addClass("transition-header");
            }
          }
        }
      });
      $(".site-menu-header li details").mouseenter(function() {    
          $(this).attr('open','');
          $(this).attr("aria-expanded", 'true');
          $("sticky-header").addClass('active');
          $("sticky-header").removeClass("transition-header");
          $(".logo-white-bg").addClass("tw-hidden");
          $(".logo-black-bg").removeClass("tw-hidden");

          if ($(window).scrollTop() > 50) {
            $("sticky-header").addClass("transition-header-black");
          } 
      }).mouseleave(function() {
        $(this).parent().removeAttr('open');
        $(this).attr("aria-expanded", 'false');
        $("sticky-header").removeClass('active');
        $(this).removeAttr('open','');
        if ($(window).scrollTop() > 50) {
          $("sticky-header").addClass("transition-header");
         }
      }); 
    }); 
  }
  $( document ).ready(function() {

  });
</script>

